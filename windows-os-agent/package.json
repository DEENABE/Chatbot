{
  "name": "local-windows-os-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "ask": "node --env-file-if-exists=.env src/client.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ollama": "node --env-file-if-exists=.env scripts/ollama-smoke.mjs",
    "recover": "node src/recover.mjs",
    "check:windows": "powershell.exe -NoProfile -File scripts/Check.ps1",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": { "ajv": "^8.17.1", "express": "^4.21.2" }
}
