{
  "name": "chanakya-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "Chanakya AI",
  "description": "Chanakya AI Desktop Assistant - Secure offline AI assistant",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "node scripts/prepare-backend.cjs && vite build && electron-builder --win",
    "electron:release": "node scripts/build-release.cjs"
  },
  "build": {
    "appId": "com.chanakya.ai",
    "productName": "Chanakya AI",
    "electronVersion": "37.10.3",
    "electronDist": "../node_modules/electron/dist",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "tools/**/*",
      {
        "from": "../node_modules/say",
        "to": "node_modules/say"
      },
      {
        "from": "../node_modules/one-time",
        "to": "node_modules/one-time"
      },
      {
        "from": "../node_modules/playwright-core",
        "to": "node_modules/playwright-core"
      }
    ],
    "afterPack": "scripts/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "perMachine": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chanakya AI"
    },
    "asar": false,
    "extraResources": [
      {
        "from": "tools/apps",
        "to": "desktop-control",
        "filter": [
            "*.ps1",
            "DesktopAccessibility.cs"
        ]
      }
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@react-spring/web": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "axios": "^1.9.0",
    "framer-motion": "^12.12.1",
    "lucide-react": "^0.511.0",
    "playwright-core": "1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "say": "^0.16.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
