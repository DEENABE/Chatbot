export function createToolRegistry(services) {
  const definitions = [];
  for (const [tool, service] of services)
    for (const a of service.getActionList()) {
      const name = `${tool}.${a.action}`;
      const risk = Object.keys(groups).find((r) => groups[r].includes(name));
      if (!risk) throw new Error(`Missing explicit permission policy: ${name}`);
      // Legacy free-form content setters would persist potentially secret values
      // inside replay metadata. Keep them internal until a payload vault exists.
      definitions.push({
        name,
        description: a.description,
        risk,
        transport:
          risk === 'CRITICAL' || ['file.open', 'file.writeFile', 'registry.setValue'].includes(name)
            ? 'BLOCKED'
            : 'TOOL_ENGINE',
        allowedScopes: ['backend', 'renderer'],
        parameterSchema: a.schema || {},
        timeout:
          name === 'winget.install' || name === 'webInstall.install' || name === 'software.install'
            ? 1260000
            : name === 'webInstall.download' || name === 'software.download'
              ? 900000
              : name === 'software.discoverOnline' || name === 'explorer.calculateFolderSize'
                ? 180000
                : name === 'explorer.searchFiles'
                  ? 90000
                  : name === 'systemSettings.setConfirmed'
                    ? 600000 // a UAC prompt plus Windows optional features can take minutes
                    : tool === 'desktop'
                      ? 90000
                      : [
                            'windowsRepair',
                            'app',
                            'uiAutomation',
                            'browser',
                            'winget',
                            'webInstall',
                            'systemSettings',
                            'software',
                            'explorer',
                          ].includes(tool)
                        ? 60000
                        : 30000,
        verificationRequired: risk !== 'READ',
        mcpExposed: mcpReads.has(name),
      });
    }
  for (const name of [
    'disk.format',
    'boot.modify',
    'security.disableDefender',
    'security.disableFirewall',
    'storage.deletePartition',
    'users.delete',
    'credentials.reset',
    'bitlocker.modify',
    'domain.join',
    'domain.remove',
  ]) {
    definitions.push({
      name,
      description: 'This critical operation is blocked.',
      risk: 'CRITICAL',
      transport: 'BLOCKED',
      allowedScopes: [],
      parameterSchema: {},
      timeout: 30000,
      verificationRequired: true,
    });
  }
  return new ToolRegistry(definitions);
}
