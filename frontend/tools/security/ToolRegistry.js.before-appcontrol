export const RISK = Object.freeze({
  READ: 'READ',
  SAFE_WRITE: 'SAFE_WRITE',
  DANGEROUS: 'DANGEROUS',
  CRITICAL: 'CRITICAL',
});
export const TRANSPORT = Object.freeze({
  MCP: 'MCP',
  TOOL_ENGINE: 'TOOL_ENGINE',
  BLOCKED: 'BLOCKED',
});
const freeze = (value) => {
  if (value && typeof value === 'object') {
    Object.values(value).forEach(freeze);
    Object.freeze(value);
  }
  return value;
};

/** Application code owns definitions. No registration endpoint is exposed. */
export class ToolRegistry {
  #definitions = new Map();
  constructor(definitions) {
    for (const definition of definitions) {
      if (
        !definition ||
        !/^[A-Za-z][A-Za-z0-9]*\.[A-Za-z][A-Za-z0-9]*$/.test(definition.name) ||
        !Object.values(RISK).includes(definition.risk) ||
        !Object.values(TRANSPORT).includes(definition.transport) ||
        !definition.parameterSchema ||
        !Array.isArray(definition.allowedScopes) ||
        !Number.isInteger(definition.timeout) ||
        definition.timeout < 1 ||
        typeof definition.description !== 'string' ||
        typeof definition.verificationRequired !== 'boolean'
      )
        throw new Error('Invalid tool definition');
      if (this.#definitions.has(definition.name)) throw new Error('Duplicate tool name');
      this.#definitions.set(
        definition.name,
        freeze(
          structuredClone({
            ...definition,
            requiresApproval: definition.risk === RISK.DANGEROUS,
          }),
        ),
      );
    }
    Object.freeze(this);
  }
  get(name) {
    return this.#definitions.get(name);
  }
  list() {
    return [...this.#definitions.values()];
  }
}

