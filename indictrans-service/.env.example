# Copy this file to .env and fill in INDICTRANS_MODEL_PATH after running
# scripts/download_model.py. All other values have working defaults.

INDICTRANS_HOST=127.0.0.1
INDICTRANS_PORT=8100

# Base directory containing en-indic/, indic-en/, indic-indic/ checkpoint
# subdirectories (produced by scripts/download_model.py --dest <this path>).
# No default — the service will not load any model without this set.
INDICTRANS_MODEL_PATH=

# auto | cpu | cuda
TRANSLATION_DEVICE=auto

INDICTRANS_MAX_CHARS=5000
INDICTRANS_MAX_NEW_TOKENS=256
INDICTRANS_NUM_BEAMS=5
