# Copy to backend/.env for development. Never include .env in an installer.
PORT=3001
HOST=127.0.0.1
OLLAMA_URL=http://127.0.0.1:11434
# Choose installed models in Settings. These are optional legacy defaults.
DEFAULT_MODEL=
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m
# A slow model is never cut off for taking long overall; an answer is stopped only after this much silence (seconds).
# FIRST_TOKEN covers model load + prompt evaluation (slow on CPU); IDLE is the gap allowed between tokens.
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=900
CHAT_IDLE_TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=25
RAG_TOP_K=5
FRONTEND_ORIGIN=http://localhost:5173
# APP_DATA_PATH may override development data; Electron sets its per-user root.
# Translation is optional and requires an already installed local service.
INDICTRANS_SERVICE_URL=http://127.0.0.1:8100
