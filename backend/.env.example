# Server
PORT=3000

# Ollama (local LLM server)
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# SQLite vector DB file
DB_PATH=./data/assistant.db
EMBEDDING_DIM=768

# RAG tuning
VECTOR_TOPK=20
RERANK_TOPK=6
CONTEXT_TOKEN_BUDGET=1500
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# Source database you are indexing FROM (your huge existing DB)
# Example for Postgres source - adjust to your real DB
SOURCE_DB_URL=postgres://user:password@localhost:5432/yourbigdb
