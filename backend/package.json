{
  "name": "local-ai-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "Local desktop AI assistant with RAG over a large database, using local LLMs (Llama/Qwen/Mistral/Gemma) via Ollama.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ingest": "node src/ingest/runIngest.js",
    "test": "node --test"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.18.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "mammoth": "^1.9.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "read-excel-file": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
